@PACKAGE_INIT@

# find_package(miniverse [version] [REQUIRED] [COMPONENTS gdal osm])
#
#   miniverse::miniverse   layers of the world in PostGIS, loaded by polygon
#   miniverse::gdal        files read with GDAL, if miniverse was built with it (the component `gdal`)
#   miniverse::osm         OpenStreetMap files read with libosmium, if miniverse was built with it (the component `osm`)

include(CMakeFindDependencyMacro)

find_dependency(schemacht)
find_dependency(Boost 1.74)

set(miniverse_gdal_FOUND @MINIVERSE_HAS_GDAL@)
if(miniverse_gdal_FOUND)
  find_dependency(GDAL CONFIG)  # @MINIVERSE_MIN_GDAL@ or newer, which miniverse was built with
endif()

set(miniverse_osm_FOUND @MINIVERSE_HAS_OSM@)
if(miniverse_osm_FOUND)  # what libosmium's file formats link; libosmium itself is only headers, and not needed to use this
  find_dependency(ZLIB)
  find_dependency(EXPAT)
  find_dependency(BZip2)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/miniverse-targets.cmake")

check_required_components(miniverse)
